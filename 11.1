import os


f =  open("timestable.txt", "w")

for i in range(1, 13):
    f.write("---------------------------------------------\n")
    f.write(f" {i} Times Table \n")
    for j in range(1, 13):
        f.write(f"{i} x {j} = {i*j}\n")
    f.write("\n")

print("File created successfully!")
Q2
import os

filename = 'primes.csv'

if os.path.exists(filename):
    with open(filename, 'r') as f:
        lines = f.readlines()
        if lines:
            start_num = int(lines[-1].strip())

new_primes = []
current = start_num + 1

while len(new_primes) < 1000:
  
    is_prime = True
    for i in range(2, int(current ** 0.5) + 1):
        if current % i == 0:
            is_prime = False
            break
            
    if is_prime and current > 1:
        new_primes.append(current)
        
    current += 1

with open(filename, 'a') as f:
    for prime in new_primes:
        f.write(f"{prime}\n")

print("finish 1000")
