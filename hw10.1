Q1
numbers = []
while True:
    try:
        x = float(input("Please,Enter a number: "))
        numbers.append(x)
    except ValueError:
        break

if len(numbers) > 0:
    average = sum(numbers) / len(numbers)
    print("Mean average =", average)
else:
    print("No valid numbers entered.")
    
